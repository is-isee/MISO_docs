msgstr "Function that writes it"

msgid "`config.yaml`"
msgstr ""

msgid "`Config::save`"
msgstr ""

msgid "既定値を補った設定"
msgstr "The configuration with defaults filled in"

msgid "`grid.bin`"
msgstr ""

msgid "`Grid::save`"
msgstr ""

msgid "全体格子の座標"
msgstr "Coordinates of the global grid"

msgid "`mpi/coords.csv`"
msgstr ""

msgid "`mpi::Shape::save`"
msgstr ""

