msgstr "None (`x * x`, `std::pow(x, y)`)"

msgid "`x**2`"
msgstr ""

msgid "足し込み"
msgstr "Accumulate"

msgid "`a += b`（`a = a + b`）。`-=`, `*=`, `/=` も同様"
msgstr "`a += b` (`a = a + b`). `-=`, `*=`, and `/=` work the same way"

msgid "`a = a + b`"
msgstr ""

msgid "1 増やす・減らす"
msgstr "Increment and decrement by 1"

